# Scans, findings and pages contain the full permission map of a share and the
# members of its groups. Never commit real ones: only the synthetic samples and
# the demo built from them are tracked.
*.csv
*.html
!samples/*.csv
!samples/lastaccess/
!samples/lastaccess/**/*.csv
!docs/demo/*.html

# Last-access logs and store backups: the sample logs are rebuilt by dev/Test-Sample.ps1,
# and real Security log exports name people and folders
*.evtx
*.xml
*.bak

# Editors and OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store
